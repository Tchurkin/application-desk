# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development: run `npx supabase start` and copy the API URL and the publishable key
# it prints. Hosted: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: import essays straight from Google Drive (see docs/google-import.md).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Optional: how students sign in (see docs/sign-in.md). "code" emails a 6-digit code instead of
# asking for a password; turn it on once the hosted project can send email to anyone.
NEXT_PUBLIC_SIGN_IN=
# "on" shows "Continue with Google" once Google sign-in is set up in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=
